---
import '~/assets/styles/tailwind.css';

interface Props {
  metadata?: {
    title?: string;
    description?: string;
  };
}

const { metadata = {} } = Astro.props;
const title = metadata.title ?? 'VQEG — Video Quality Experts Group';
const description =
  metadata.description ??
  'VQEG brings international experts together to advance video quality and Quality of Experience.';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}assets/favicon.ico`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <title>{title}</title>
  </head>
  <body class="bg-white font-sans text-slate-800 antialiased">
    <slot />
  </body>
</html>
