---
import { getEntry, render } from 'astro:content';
import ContentPage from '~/components/vqeg/ContentPage.astro';
import VqegLayout from '~/layouts/VqegLayout.astro';

const page = await getEntry('page', 'about');
if (!page) return new Response(null, { status: 404 });
const { Content } = await render(page);
---

<VqegLayout title={page.data.title}>
  <ContentPage title={page.data.title}>
    <Content />
  </ContentPage>
</VqegLayout>
